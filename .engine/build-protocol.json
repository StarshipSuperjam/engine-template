{
  "schema_version": "build-protocol.v1",
  "validation_commands": {
    "candidate": [
      {
        "id": "engine-ci",
        "label": "Engine CI — the full mechanical check suite",
        "command": [
          "uv",
          "run",
          "--directory",
          ".engine",
          "--frozen",
          "--",
          "python",
          "tools/validate.py",
          "--suite",
          "CI"
        ]
      },
      {
        "id": "engine-selftest",
        "label": "Engine self-tests — affected selection against the merge base, with a run record",
        "command": [
          "uv",
          "run",
          "--directory",
          ".engine",
          "--frozen",
          "--",
          "python",
          "tools/selftest.py",
          "--changed-from",
          "{merge_base}",
          "--run-record-path",
          "{run_record_path}"
        ]
      }
    ],
    "final": {
      "mode": "ci-import",
      "context": "engine-ci",
      "workflow": ".github/workflows/engine-ci.yml",
      "receipt_artifact": "engine-ci-receipt",
      "max_age_days": 14
    }
  },
  "deliverable_review": {
    "quick": [],
    "standard": [
      "spec-conformance",
      "divergence-hunter",
      "usability"
    ],
    "thorough": [
      "spec-conformance",
      "divergence-hunter",
      "usability",
      "technical-integrity",
      "security-governance"
    ]
  },
  "preflights": [
    {
      "id": "close-linkage",
      "command": [
        "python",
        ".engine/tools/close_linkage_preflight.py",
        "check"
      ],
      "required": false
    },
    {
      "id": "pr-contract",
      "command": [],
      "required": true
    },
    {
      "id": "checkout-integrity",
      "command": [],
      "required": true
    },
    {
      "id": "checkout-worktrees",
      "command": [],
      "required": false
    }
  ],
  "hard_holds": [
    {
      "id": "plan-authority",
      "prevents": "work or review using a plan other than the one the operator approved"
    },
    {
      "id": "approval",
      "prevents": "implementation before the operator approves the plan and review depth"
    },
    {
      "id": "review-coverage",
      "prevents": "silently omitting review coverage the operator approved"
    },
    {
      "id": "deliverable-review",
      "prevents": "submitting without an independent deliverable-review gate"
    },
    {
      "id": "validation-freshness",
      "prevents": "packets or submission standing on candidate evidence for a commit other than the one presented"
    },
    {
      "id": "final-import",
      "prevents": "marking ready without an imported, verified engine-ci proof for the exact submitted head"
    },
    {
      "id": "repair-judgment",
      "prevents": "post-review changes bypassing a proportional re-review decision"
    },
    {
      "id": "blocking-finding",
      "prevents": "submitting a finding the orchestrator explicitly left blocking this PR"
    },
    {
      "id": "preflights",
      "prevents": "skipping or ignoring a repository submission preflight"
    },
    {
      "id": "pr-contract",
      "prevents": "presenting an incomplete merge surface to the operator"
    },
    {
      "id": "draft-identity",
      "prevents": "building against the wrong, closed, or already-ready pull request"
    },
    {
      "id": "human-merge",
      "prevents": "the coordinator crossing the operator-only merge boundary"
    }
  ],
  "phase_runbooks": {
    "planning": "build-kickoff.md",
    "implementation": "build-implementation.md",
    "engineering-decision": "build-plan-correction.md",
    "finding-disposition": "build-validation-and-review.md",
    "deliverable-review": "build-validation-and-review.md",
    "repair-assessment": "build-validation-and-review.md",
    "final-validation": "build-validation-and-review.md",
    "submission-preflight": "build-submission.md",
    "ready": "build-submission.md"
  },
  "review_consumers": [
    {
      "stage": "plan-review gate",
      "roster": "plan-review"
    },
    {
      "stage": "product-design spec lock",
      "roster": "plan-review"
    },
    {
      "stage": "pre-submission gate",
      "roster": "deliverable-review"
    }
  ]
}
