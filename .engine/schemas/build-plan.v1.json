{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-plan.v1 — the exact plan approved for one Build",
  "description": "A reasoning referent, not a certificate that the reasoning is correct.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "raw_intent", "interpretation", "evidence", "assumptions", "objective", "success_obligations", "scope_boundary", "non_goals", "risks", "implementation_outline", "review_strategy", "spec"],
  "properties": {
    "schema_version": {"const": "build-plan.v1"},
    "raw_intent": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "objective": {"type": "string", "minLength": 1},
    "success_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}},
    "scope_boundary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "implementation_outline": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_strategy": {"type": "string", "minLength": 1},
    "spec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["posture", "disclosure"],
          "properties": {"posture": {"const": "none"}, "disclosure": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["posture", "digest", "mapping"],
          "properties": {
            "posture": {"const": "settled"},
            "digest": {"$ref": "#/$defs/digest"},
            "mapping": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "basis", "kind"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "kind": {"enum": ["observed", "inferred"]}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "status"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "accepted-risk", "unresolved"]}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "verification"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1}
      }
    }
  }
}
