{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-handoff.v2 — bounded cold-session continuation evidence for a DAG Build",
  "description": "Extends build-handoff.v1 with a bounded per-node `work` projection so a restored DAG Build derives its node lifecycle. A restored claim without a returned result derives recovery_required; nothing expires automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build", "plan", "approval", "reviews", "finding_summaries", "progress", "work", "validation", "repair", "preflights", "pr_contract"],
  "properties": {
    "schema_version": {"const": "build-handoff.v2"},
    "build": {"type": "object"},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "digest", "intent_digest", "spec_digest", "durable_issue", "profile", "bound_head", "promotion_nonce"],
      "properties": {
        "source": {"const": "issue"}, "digest": {"type": "string"}, "intent_digest": {"type": "string"},
        "spec_digest": {"type": ["string", "null"]}, "durable_issue": {"type": "integer", "minimum": 1},
        "profile": {"enum": ["normal", "routine"]}, "bound_head": {"type": "string"},
        "promotion_nonce": {"type": ["string", "null"]}
      }
    },
    "approval": {"type": ["object", "null"]},
    "reviews": {"type": "object"},
    "finding_summaries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "stage", "lens", "packet_digest", "lens_packet_digest", "commit", "severity", "disposition", "escalation_kind", "blocks_this_pr", "summary", "operator_summary"],
        "properties": {
          "id": {"type": "string"}, "stage": {"enum": ["plan", "deliverable", "repair"]},
          "lens": {"type": "string"}, "packet_digest": {"type": "string"}, "lens_packet_digest": {"type": "string"}, "commit": {"type": ["string", "null"]},
          "severity": {"enum": ["blocking", "serious", "nit"]},
          "disposition": {"type": "string"},
          "escalation_kind": {"type": ["string", "null"], "enum": [null, "design", "law", "authority", "capability-boundary", "guardrail-ack", "operator-only"]},
          "blocks_this_pr": {"type": "boolean"}, "summary": {"type": "string", "minLength": 1},
          "operator_summary": {"type": ["string", "null"]}
        }
      }
    },
    "progress": {"type": "object"},
    "work": {"type": "object"},
    "validation": {"type": ["object", "null"]},
    "repair": {"type": ["object", "null"]},
    "preflights": {"type": "array"},
    "pr_contract": {"type": ["object", "null"]}
  }
}
