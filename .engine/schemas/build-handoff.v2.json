{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-handoff.v2 — bounded cold-session continuation evidence for a DAG Build",
  "description": "Extends build-handoff.v1 with a bounded per-node `work` projection so a restored DAG Build derives its node lifecycle. A restored claim without a returned result derives recovery_required; nothing expires automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build", "plan", "approval", "reviews", "finding_summaries", "progress", "work", "validation", "repair", "preflights", "pr_contract"],
  "properties": {
    "plan_change_escalations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reviewed_plan_digest", "plan_digest", "operator_change"], "properties": {"reviewed_plan_digest": {"type": "string"}, "plan_digest": {"type": "string"}, "operator_change": {"type": "string"}}}},
    "reconciles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from_commit", "to_commit", "base_before", "base_after", "contribution_identical", "divergent_paths", "anchored_to"], "properties": {"from_commit": {"type": "string"}, "to_commit": {"type": "string"}, "base_before": {"type": ["string", "null"]}, "base_after": {"type": "string"}, "contribution_identical": {"type": "boolean"}, "divergent_paths": {"type": "array", "items": {"type": "string"}}, "unmeasurable": {"type": ["string", "null"]}, "anchored_to": {"type": "string"}}}},
    "repair_rounds": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reviewed_commit", "final_commit", "judgment", "lenses"], "properties": {"reviewed_commit": {"type": "string"}, "final_commit": {"type": "string"}, "judgment": {"enum": ["none", "scoped", "full"]}, "lenses": {"type": "array", "items": {"type": "string"}}, "guidance": {"type": ["string", "null"]}, "counted": {"type": "boolean"}, "anchor": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "anchor_note": {"type": ["string", "null"], "enum": [null, "reconcile", "rewritten"]}, "roster_provenance": {"enum": ["explicit", "blocker-union", "none"]}, "classification": {"type": "object", "additionalProperties": false, "required": ["files", "churn", "total_churn"], "properties": {"anchor": {"type": "string"}, "head": {"type": "string"}, "total_churn": {"type": "integer", "minimum": 0}, "guards_read": {"type": "boolean"}, "files": {"type": "object", "additionalProperties": false, "properties": {"guarded": {"type": "array", "items": {"type": "string"}}, "derived": {"type": "array", "items": {"type": "string"}}, "docs": {"type": "array", "items": {"type": "string"}}, "authored": {"type": "array", "items": {"type": "string"}}}}, "churn": {"type": "object", "additionalProperties": false, "properties": {"guarded": {"type": "integer", "minimum": 0}, "derived": {"type": "integer", "minimum": 0}, "docs": {"type": "integer", "minimum": 0}, "authored": {"type": "integer", "minimum": 0}}}}}}}},
    "schema_version": {"const": "build-handoff.v2"},
    "build": {"type": "object"},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "sealed_digest", "diverged_from_seal", "digest", "intent_digest",
                   "spec_digest", "authorizing_issue", "profile", "bound_head"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^pln_[0-9a-f]{12}$"},
        "sealed_digest": {"type": "string"},
        "diverged_from_seal": {"const": false,
                               "description": "A handoff is only exportable while the executed plan still equals the sealed one: a cold session recovers the SEALED payload from the library, so a diverged Build would resume against a plan nobody is building."},
        "digest": {"type": "string"}, "intent_digest": {"type": "string"},
        "spec_digest": {"type": ["string", "null"]},
        "authorizing_issue": {"type": ["integer", "null"], "minimum": 1},
        "profile": {"enum": ["normal", "routine"]}, "bound_head": {"type": "string"}
      }
    },
    "approval": {"type": ["object", "null"]},
    "reviews": {"type": "object"},
    "finding_summaries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "stage", "lens", "packet_digest", "lens_packet_digest", "commit", "severity", "disposition", "escalation_kind", "blocks_this_pr", "summary", "operator_summary"],
        "properties": {
          "id": {"type": "string"}, "stage": {"enum": ["plan", "deliverable", "repair"]},
          "lens": {"type": "string"}, "packet_digest": {"type": "string"}, "lens_packet_digest": {"type": "string"}, "commit": {"type": ["string", "null"]},
          "severity": {"enum": ["blocking", "serious", "nit"]},
          "disposition": {"type": "string"},
          "escalation_kind": {"type": ["string", "null"], "enum": [null, "design", "law", "authority", "capability-boundary", "guardrail-ack", "operator-only"]},
          "blocks_this_pr": {"type": "boolean"}, "summary": {"type": "string", "minLength": 1},
          "operator_summary": {"type": ["string", "null"]}
        }
      }
    },
    "progress": {"type": "object"},
    "work": {"type": "object", "additionalProperties": {"$ref": "#/$defs/handoff_node_work"}},
    "validation": {"type": ["object", "null"]},
    "repair": {"type": ["object", "null"]},
    "preflights": {"type": "array"},
    "pr_contract": {"type": ["object", "null"]}
  },
  "$defs": {
    "handoff_node_work": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_count", "claim", "latest_result", "integration", "latest_failure"],
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 0},
        "claim": {"type": ["object", "null"]},
        "latest_result": {"type": ["object", "null"]},
        "integration": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/handoff_integration"}]},
        "latest_failure": {"type": ["object", "null"]}
      }
    },
    "handoff_integration": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "commit", "focused_verification"],
      "properties": {
        "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "focused_verification": {"type": "string", "minLength": 1},
        "receipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/handoff_receipt"}]},
        "restored": {"type": "boolean"}
      }
    },
    "handoff_receipt": {
      "comment": "The receipt's machine facts publish into the PR body; only degraded_reason is redacted like other worker prose, so it may be the redaction sentinel string rather than the original reason.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "claim_base", "integration_commit", "attributable_range",
                   "patch_digest", "tree_digest", "paths", "identity_mode", "degraded", "degraded_reason"],
      "properties": {
        "schema_version": {"const": "build-integration-receipt.v1"},
        "claim_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "integration_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "attributable_range": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
        "patch_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "paths": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "path", "old_path"],
          "properties": {
            "status": {"enum": ["A", "M", "D", "R"]},
            "path": {"type": "string", "minLength": 1},
            "old_path": {"type": ["string", "null"], "minLength": 1}
          }
        }},
        "identity_mode": {"enum": ["worker-commit", "accepted-candidate"]},
        "degraded": {"type": "boolean"},
        "degraded_reason": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
