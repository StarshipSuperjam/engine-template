{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engine.local/schemas/persistent-store-identity.v1.json",
  "title": "Persistent store identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "store_id", "project_repository", "target_kind"],
  "properties": {
    "schema_version": {"const": "persistent-store-identity.v1"},
    "store_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "project_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "target_kind": {"enum": ["canonical", "disposable"]}
  }
}
