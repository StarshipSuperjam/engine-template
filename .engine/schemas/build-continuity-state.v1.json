{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-continuity-state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "progress_token", "claimed", "diagnostic_emitted"],
  "properties": {
    "schema_version": {"const": "build-continuity-state.v1"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["worktree", "plan_id", "sealed_digest"], "properties": {"worktree": {"type": "string"}, "plan_id": {"type": "string"}, "sealed_digest": {"type": "string"}}},
    "progress_token": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claimed": {"type": "boolean"},
    "diagnostic_emitted": {"type": "boolean"}
  }
}
