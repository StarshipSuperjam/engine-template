{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operator-issue-triage.v1 \u2014 preserved per-repository milestone choices",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "const": "operator-issue-triage.v1"
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activated_at",
          "milestones"
        ],
        "properties": {
          "activated_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "milestones": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "none",
              "patch",
              "minor",
              "major"
            ],
            "properties": {
              "none": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "patch": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "major": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "migrated_sources": {
      "type": "object",
      "description": "Exact legacy copies acknowledged by explicit canonical configuration migration; changed copies require new resolution.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
