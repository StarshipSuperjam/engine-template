{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-protocol.v1 — current runtime Build mechanics",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "deliverable_review", "validation_commands", "preflights", "hard_holds"],
  "properties": {
    "schema_version": {"const": "build-protocol.v1"},
    "deliverable_review": {"$ref": "#/$defs/depths"},
    "validation_commands": {
      "description": "The split evidence model. `candidate` commands run locally during the build loop — the structural suite and the affected-selection self-test run; the only substitution tokens a command may carry are {merge_base} and {run_record_path}, both coordinator-owned, and a brace may appear ONLY as one of those two whole tokens — embedded or compound brace tokens are rejected too, so a placeholder can never be invented in the registry and silently substituted (or half-substituted) downstream. `final` is not a command at all: it names the CI proof the coordinator IMPORTS — the required context, the workflow file the platform must report as the run's source, the receipt artifact, and the age bound — because the full-inventory merge proof is the engine-ci run, never a local execution. Duplicate candidate ids are refused by the registry's own test, since this schema cannot express cross-item uniqueness.",
      "type": "object", "additionalProperties": false, "required": ["candidate", "final"],
      "properties": {
        "candidate": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "command"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^(\\{(merge_base|run_record_path)\\}|[^{]+)$"}}}}},
        "final": {"type": "object", "additionalProperties": false, "required": ["mode", "context", "workflow", "receipt_artifact", "max_age_days"], "properties": {"mode": {"const": "ci-import"}, "context": {"type": "string", "minLength": 1}, "workflow": {"type": "string", "minLength": 1}, "receipt_artifact": {"type": "string", "minLength": 1}, "max_age_days": {"type": "integer", "minimum": 1}}}
      }
    },
    "preflights": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "command", "required"], "properties": {"id": {"type": "string", "minLength": 1}, "command": {"type": "array", "items": {"type": "string"}}, "required": {"type": "boolean"}}}},
    "hard_holds": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "prevents"], "properties": {"id": {"type": "string", "minLength": 1}, "prevents": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "depths": {"type": "object", "additionalProperties": false, "required": ["quick", "standard", "thorough"], "properties": {"quick": {"$ref": "#/$defs/lenses"}, "standard": {"$ref": "#/$defs/lenses"}, "thorough": {"$ref": "#/$defs/lenses"}}},
    "lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
