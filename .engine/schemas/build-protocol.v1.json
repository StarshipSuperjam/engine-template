{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-protocol.v1 — declarative Build mechanics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preservation_source", "plan_review", "deliverable_review", "preflights", "hard_holds", "obligations"],
  "properties": {
    "schema_version": {"const": "build-protocol.v1"},
    "preservation_source": {
      "type": "object", "additionalProperties": false,
      "required": ["git_object", "digest", "lines", "words", "assurance"],
      "properties": {
        "git_object": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "lines": {"type": "integer", "minimum": 1},
        "words": {"type": "integer", "minimum": 1},
        "assurance": {"type": "string", "minLength": 1}
      }
    },
    "plan_review": {"$ref": "#/$defs/depths"},
    "deliverable_review": {"$ref": "#/$defs/depths"},
    "preflights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "array", "items": {"type": "string"}},
          "required": {"type": "boolean"}
        }
      }
    },
    "hard_holds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prevents"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "prevents": {"type": "string", "minLength": 1}
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/obligation"}
    }
  },
  "$defs": {
    "depths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quick", "standard", "thorough"],
      "properties": {
        "quick": {"$ref": "#/$defs/lenses"},
        "standard": {"$ref": "#/$defs/lenses"},
        "thorough": {"$ref": "#/$defs/lenses"}
      }
    },
    "lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "classification", "disposition", "owner", "anchor"],
      "properties": {
        "id": {"type": "string", "pattern": "^BO-[0-9]{2}$"},
        "intent": {"type": "string", "minLength": 1},
        "classification": {"enum": ["mechanical-fact", "ai-judgment", "operator-authority", "advisory-practice", "recovery-behavior", "special-delivery-path"]},
        "disposition": {"enum": ["mechanical", "prose", "superseded"]},
        "scope": {"enum": ["all", "home-only"]},
        "owner": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1}
      }
    }
  }
}
