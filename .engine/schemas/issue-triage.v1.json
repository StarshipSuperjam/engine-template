{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "issue-triage.v1 \u2014 issue-owned assessment and independent assignment state",
  "$ref": "#/$defs/record",
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "submission_id",
        "revision",
        "evidence",
        "assessment",
        "assignment",
        "disposition",
        "superseded",
        "updated_at"
      ],
      "properties": {
        "schema_version": {
          "const": "issue-triage.v1"
        },
        "submission_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "assigned",
                "disabled",
                "human-preserved",
                "resolution-failed",
                "write-uncertain",
                "conflict"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "milestone": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "disposition": {
          "type": [
            "object",
            "null"
          ]
        },
        "superseded": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "assessment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "impact",
            "remedy",
            "rationale",
            "evidence"
          ],
          "properties": {
            "state": {
              "const": "assessed"
            },
            "impact": {
              "enum": [
                "none",
                "patch",
                "minor",
                "major"
              ]
            },
            "remedy": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "unknown",
            "next_action"
          ],
          "properties": {
            "state": {
              "const": "pending"
            },
            "unknown": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "next_action": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
