{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case",
    "source_tree",
    "source_digest",
    "mode",
    "path",
    "qualified_name",
    "owner",
    "reason"
  ],
  "properties": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "occurrence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "opaque-uuid4",
        "opaque-git-sha",
        "unordered-subtests"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "qualified_name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
