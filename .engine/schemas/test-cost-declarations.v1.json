{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases",
    "mappings"
  ],
  "properties": {
    "schema_version": {
      "const": "test-cost-declarations.v1"
    },
    "cases": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "occurrence",
          "path",
          "qualified_name",
          "source_digest",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "qualified_name": {
            "type": "string",
            "minLength": 1
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "contract": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "supported_fault",
              "boundary",
              "boundary_rationale",
              "fixture_owner",
              "dependencies",
              "data_reads",
              "cadence",
              "limits",
              "mutable_state",
              "cache_lifetime",
              "added_cost_risk",
              "families"
            ],
            "properties": {
              "schema_version": {
                "const": "test-cost-contract.v1"
              },
              "supported_fault": {
                "type": "string",
                "minLength": 1
              },
              "boundary": {
                "enum": [
                  "pure",
                  "filesystem",
                  "process",
                  "integration"
                ]
              },
              "boundary_rationale": {
                "type": "string",
                "minLength": 1
              },
              "fixture_owner": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "data_reads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "cadence": {
                "enum": [
                  "pr",
                  "nightly",
                  "release"
                ]
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "processes",
                  "git_commands",
                  "schema_decodes",
                  "metaschema_validations",
                  "whole_tree_fixtures",
                  "nested_journeys"
                ],
                "properties": {
                  "processes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "git_commands": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "schema_decodes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "metaschema_validations": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "whole_tree_fixtures": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nested_journeys": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "mutable_state": {
                "type": "string",
                "minLength": 1
              },
              "cache_lifetime": {
                "enum": [
                  "none",
                  "case",
                  "class",
                  "module",
                  "run"
                ]
              },
              "added_cost_risk": {
                "type": "string",
                "minLength": 1
              },
              "families": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "case_patterns",
                    "input_sizes",
                    "growth_limits"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "case_patterns": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "input_sizes": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "minItems": 2
                    },
                    "growth_limits": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "processes",
                        "git_commands",
                        "schema_decodes",
                        "metaschema_validations",
                        "whole_tree_fixtures",
                        "nested_journeys"
                      ],
                      "properties": {
                        "processes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "git_commands": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "schema_decodes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "metaschema_validations": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "whole_tree_fixtures": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "nested_journeys": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                },
                "minItems": 0
              }
            }
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "supported_fault"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "occurrence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "occurrence"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "occurrence": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "qualified_name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "supported_fault": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "source"
            ]
          },
          {
            "required": [
              "target",
              "path",
              "qualified_name"
            ]
          }
        ]
      }
    }
  }
}
