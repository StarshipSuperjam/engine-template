{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operator-issue-recovery.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "const": "operator-issue-recovery.v1"
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "genesis"
        ],
        "properties": {
          "repository_id": {
            "type": "integer",
            "minimum": 1
          },
          "genesis": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  }
}
