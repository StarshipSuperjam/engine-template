{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starshipsuperjam.github.io/engine/schemas/persistent-mutation-registry.v1.json",
  "title": "Persistent mutation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "persistent-mutation-registry.v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "code_referent", "writer", "target_kind", "effect_class", "declared_cardinality",
        "schema_cutover", "recovery_requirement", "allowed_invocation_modes", "capability_identity", "callers"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "code_referent": {
          "type": "string",
          "pattern": "^\\.engine/tools/.+\\.(?:py|sh):[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "writer": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
        "target_kind": {
          "enum": [
            "ledger", "ledger-metadata", "derived-index", "capture-cursor", "lifecycle-marker",
            "degraded-health", "backup-pointer", "remote-vault", "remote-git-ref", "restore-journal",
            "erasure-proposal", "export-artifact", "ephemeral-staging", "semantic-index",
            "project-repository", "tracked-finding"
          ]
        },
        "effect_class": {
          "enum": ["semantic-read", "durable-append", "reversible-mutation", "destructive-irreversible"]
        },
        "declared_cardinality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum", "unit"],
          "properties": {
            "maximum": {"type": ["integer", "null"], "minimum": 0},
            "unit": {"enum": ["records", "files", "rows", "repositories", "status-records"]}
          }
        },
        "schema_cutover": {"type": "boolean"},
        "recovery_requirement": {
          "enum": [
            "none", "append-lock", "atomic-replace", "derived-rebuild", "compare-and-set", "durable-journal",
            "backup-snapshot", "operator-merged-consent", "remote-ref-compare-and-set", "best-effort-diagnostic"
          ]
        },
        "allowed_invocation_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["automatic", "attended"]}
        },
        "capability_identity": {"type": "string", "pattern": "^persistent-mutation/[a-z0-9-]+$"},
        "callers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
