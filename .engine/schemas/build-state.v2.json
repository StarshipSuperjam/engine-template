{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-state.v2 — current local evidence for one DAG Build",
  "description": "Extends build-state.v1 with a per-node `work` map holding claim, result, integration, and failure evidence for each work item. Node lifecycle (blocked|ready|claimed|returned|failed|recovery_required|complete) is DERIVED from this evidence and the approved plan, never stored as an enum. progress.completed continues to record integrated commits so the existing handoff-restore ancestry check protects v2 Builds unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "build", "plan", "approval", "reviews", "findings", "checkpoint", "progress", "work", "validation", "repair", "preflights", "pr_contract", "submission"],
  "properties": {
    "schema_version": {"const": "build-state.v2"},
    "revision": {"type": "integer", "minimum": 1},
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "pr", "base_at_bind", "mode"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pr": {"type": "integer", "minimum": 1},
        "base_at_bind": {"$ref": "#/$defs/commit"},
        "mode": {"enum": ["same-session", "unattended"]}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "digest", "intent_digest", "spec_digest", "durable_issue", "profile", "bound_head", "promotion_nonce"],
      "properties": {
        "source": {"enum": ["session", "issue"]},
        "digest": {"$ref": "#/$defs/digest"},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "spec_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "durable_issue": {"type": ["integer", "null"], "minimum": 1},
        "profile": {"enum": ["trivial", "normal", "routine"]},
        "bound_head": {"$ref": "#/$defs/commit"},
        "promotion_nonce": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"}
      }
    },
    "approval": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["plan_digest", "spec_digest", "depth"], "properties": {"plan_digest": {"$ref": "#/$defs/digest"}, "spec_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "depth": {"enum": ["quick", "standard", "thorough"]}}}
      ]
    },
    "reviews": {
      "type": "object", "additionalProperties": false,
      "required": ["plan", "deliverable"],
      "properties": {"plan": {"$ref": "#/$defs/review_stage"}, "deliverable": {"$ref": "#/$defs/review_stage"}}
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "assumption_dispositions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim", "resolved_as", "basis"], "properties": {"claim": {"type": "string", "minLength": 1}, "resolved_as": {"enum": ["verified", "accepted-risk"]}, "basis": {"type": "string", "minLength": 1}}}},
    "checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checkpoint"}]},
    "progress": {
      "type": "object", "additionalProperties": false, "required": ["current_item", "completed"],
      "properties": {
        "current_item": {"type": ["string", "null"]},
        "completed": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "commit"], "properties": {"id": {"type": "string"}, "commit": {"$ref": "#/$defs/commit"}}}}
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/node_work"}
    },
    "validation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result_set"}]},
    "repair": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["reviewed_commit", "final_commit", "summary", "judgment", "rationale", "lenses", "packet_digest", "receipts"], "properties": {
          "reviewed_commit": {"$ref": "#/$defs/commit"}, "final_commit": {"$ref": "#/$defs/commit"},
          "summary": {"type": "string", "minLength": 1}, "judgment": {"enum": ["none", "scoped", "full"]},
          "rationale": {"type": "string", "minLength": 1}, "lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "packet_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "referent_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "reviewer_contracts": {"type": "array", "items": {"$ref": "#/$defs/reviewer_contract"}},
          "receipts": {"type": "array", "items": {"$ref": "#/$defs/review_receipt"}}
        }}
      ]
    },
    "preflights": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "pr_contract": {
      "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["commit", "body_digest", "complete"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "body_digest": {"$ref": "#/$defs/digest"}, "complete": {"type": "boolean"}}}]
    },
    "submission": {"enum": ["draft", "ready", "unknown"]},
    "checkout_snapshot": {
      "type": ["object", "null"],
      "description": "The review_integrity snapshot of the build worktree captured when the most recent deliverable/repair review packet was created (StarshipSuperjam/engine-template#947); the submission preflight verifies origin, branch, and stash have not moved since. Null until a deliverable-side review packet is created; not carried across a cold handoff (re-captured at the next review packet).",
      "additionalProperties": false,
      "properties": {
        "checkout": {"type": "string"},
        "origin": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "head": {"type": ["string", "null"]},
        "stash_count": {"type": ["integer", "null"]},
        "worktrees": {"type": ["array", "null"]}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "node_work": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_count", "claim", "latest_result", "integration", "latest_failure"],
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 0},
        "claim": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/claim"}]},
        "latest_result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/node_result"}]},
        "integration": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/integration"}]},
        "latest_failure": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/node_failure"}]}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "base_sha", "worktree", "acquired_resources", "requested_route", "worker_ref", "restored"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "base_sha": {"$ref": "#/$defs/commit"},
        "worktree": {"type": "string", "minLength": 1},
        "acquired_resources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requested_route": {"$ref": "#/$defs/route"},
        "worker_ref": {"type": ["string", "null"], "minLength": 1},
        "restored": {"type": "boolean"}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_class", "provider", "model", "effort", "inline"],
      "properties": {
        "executor_class": {"enum": ["integrator", "builder", "bounded"]},
        "provider": {"enum": ["claude", "codex"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "inline": {"type": "boolean"}
      }
    },
    "node_result": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "base_sha", "outcome", "artifact_ref", "artifact_digest", "evidence"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "base_sha": {"$ref": "#/$defs/commit"},
        "outcome": {"enum": ["returned", "failed"]},
        "artifact_ref": {"type": ["string", "null"], "minLength": 1},
        "artifact_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["changed_paths", "verification_results", "assumptions", "unresolved_concerns"],
          "properties": {
            "changed_paths": {"type": "array", "items": {"type": "string"}},
            "verification_results": {"type": "array", "items": {"type": "string"}},
            "assumptions": {"type": "array", "items": {"type": "string"}},
            "unresolved_concerns": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "integration": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "commit", "focused_verification"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "commit": {"$ref": "#/$defs/commit"},
        "focused_verification": {"type": "string", "minLength": 1}
      }
    },
    "node_failure": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "class", "reason", "disposition"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "class": {"enum": ["dispatch", "worker", "contract", "verification", "integration"]},
        "reason": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["open", "retry", "abandoned", "integrator-inline"]}
      }
    },
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "review_stage": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_digest", "referent_digest", "required_lenses", "installed_lenses", "reviewer_contracts", "receipts", "reviewed_commit", "base_commit", "waiver"],
      "properties": {
        "packet_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "referent_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "required_lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "installed_lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reviewer_contracts": {"type": "array", "items": {"$ref": "#/$defs/reviewer_contract"}},
        "receipts": {"type": "array", "items": {"$ref": "#/$defs/review_receipt"}},
        "reviewed_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "base_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "waiver": {"oneOf": [
          {"type": "null"},
          {"type": "object", "additionalProperties": false, "required": ["plan_digest", "depth", "reason", "adopted_commit"], "properties": {
            "plan_digest": {"$ref": "#/$defs/digest"}, "depth": {"enum": ["quick", "standard", "thorough"]},
            "reason": {"type": "string", "minLength": 1}, "adopted_commit": {"$ref": "#/$defs/commit"}
          }}
        ]}
      }
    },
    "review_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["lens", "packet_digest", "commit", "finding_ids"],
      "properties": {
        "lens": {"type": "string", "minLength": 1}, "packet_digest": {"$ref": "#/$defs/digest"},
        "referent_digest": {"$ref": "#/$defs/digest"}, "lens_packet_digest": {"$ref": "#/$defs/digest"},
        "commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "code_execution": {"enum": ["none", "discarded-copy"]}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "lens", "packet_digest", "commit", "severity", "summary", "disposition", "rationale", "escalation_kind", "blocks_this_pr", "handoff_summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "stage": {"enum": ["plan", "deliverable", "repair"]}, "lens": {"type": "string", "minLength": 1},
        "packet_digest": {"$ref": "#/$defs/digest"}, "lens_packet_digest": {"$ref": "#/$defs/digest"}, "commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "severity": {"enum": ["blocking", "serious", "nit"]}, "summary": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["accepted-fixed", "accepted-tracked", "partially-accepted", "rejected", "escalated"]},
        "rationale": {"type": "string", "minLength": 1},
        "escalation_kind": {"type": ["string", "null"], "enum": [null, "design", "law", "authority", "capability-boundary", "guardrail-ack", "operator-only"]},
        "blocks_this_pr": {"type": "boolean"},
        "handoff_summary": {"type": ["string", "null"], "minLength": 1},
        "operator_summary": {"type": ["string", "null"], "minLength": 1},
        "private_reference": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "reviewer_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["lens", "path", "digest", "lens_packet_digest"],
      "properties": {
        "lens": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}, "lens_packet_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_digest", "objective", "current_work", "work_item", "assumptions", "non_goals", "planned_scope", "changed_paths", "remaining_verification", "judgment", "progress"],
      "properties": {
        "plan_digest": {"$ref": "#/$defs/digest"}, "objective": {"type": "string", "minLength": 1}, "current_work": {"type": "string", "minLength": 1},
        "work_item": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}}, "non_goals": {"type": "array", "items": {"type": "string"}},
        "planned_scope": {"type": "array", "items": {"type": "string"}}, "changed_paths": {"type": "array", "items": {"type": "string"}},
        "remaining_verification": {"type": "array", "items": {"type": "string"}},
        "judgment": {"enum": ["aligned", "plan_revision_required", "operator_decision_required"]},
        "progress": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "commit", "passed", "summary"],
      "properties": {"id": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/commit"}, "passed": {"type": "boolean"}, "summary": {"type": "string", "minLength": 1}, "log_path": {"type": "string", "minLength": 1}, "log_digest": {"$ref": "#/$defs/digest"}}
    },
    "result_set": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "results"],
      "properties": {"commit": {"$ref": "#/$defs/commit"}, "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}}
    }
  }
}
