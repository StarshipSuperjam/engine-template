{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build-state.v2 — current local evidence for one DAG Build",
  "description": "Extends build-state.v1 with a per-node `work` map holding claim, result, integration, and failure evidence for each work item. Node lifecycle (blocked|ready|claimed|returned|failed|recovery_required|complete) is DERIVED from this evidence and the approved plan, never stored as an enum. progress.completed continues to record integrated commits so the existing handoff-restore ancestry check protects v2 Builds unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "build", "plan", "approval", "reviews", "findings", "checkpoint", "progress", "work", "validation", "repair", "preflights", "pr_contract", "submission"],
  "properties": {
    "plan_change_escalations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reviewed_plan_digest", "plan_digest", "operator_change"], "properties": {"reviewed_plan_digest": {"type": "string"}, "plan_digest": {"type": "string"}, "operator_change": {"type": "string"}}}},
    "repair_rounds": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reviewed_commit", "final_commit", "judgment", "lenses"], "properties": {"reviewed_commit": {"type": "string"}, "final_commit": {"type": "string"}, "judgment": {"enum": ["none", "scoped", "full"]}, "lenses": {"type": "array", "items": {"type": "string"}}, "guidance": {"type": ["string", "null"]}, "counted": {"type": "boolean"}, "anchor": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "anchor_note": {"type": ["string", "null"], "enum": [null, "reconcile", "rewritten"]}, "roster_provenance": {"enum": ["explicit", "blocker-union", "none"]}, "classification": {"$ref": "#/$defs/divergence_classification"}}}},
    "reconciles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from_commit", "to_commit", "base_before", "base_after", "contribution_identical", "divergent_paths", "anchored_to"], "properties": {"from_commit": {"type": "string"}, "to_commit": {"type": "string"}, "base_before": {"type": ["string", "null"]}, "base_after": {"type": "string"}, "contribution_identical": {"type": "boolean"}, "divergent_paths": {"type": "array", "items": {"type": "string"}}, "unmeasurable": {"type": ["string", "null"]}, "anchored_to": {"type": "string"}}}},
    "schema_version": {"const": "build-state.v2"},
    "revision": {"type": "integer", "minimum": 1},
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "pr", "base_at_bind", "mode"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pr": {"type": "integer", "minimum": 1},
        "base_at_bind": {"$ref": "#/$defs/commit"},
        "mode": {"enum": ["same-session", "unattended"]},
        "worktree": {"type": "string", "minLength": 1,
                     "description": "Absolute path of the worktree this Build runs in. How a session that restarted finds its durable snapshot again: the worktree is what the session is standing in, where a pointer file is something the crash could have taken with it. Optional, because a snapshot addressed by an explicit --state path needs no such lookup."}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "sealed_digest", "diverged_from_seal", "digest", "intent_digest",
                   "spec_digest", "authorizing_issue", "profile", "bound_head"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^pln_[0-9a-f]{12}$",
                    "description": "The sealed plan in the local library that this Build entered on. A plan reaches a Build only this way; there is no Issue-carried plan and no session-local plan."},
        "sealed_digest": {"$ref": "#/$defs/digest",
                          "description": "The plan-document digest the seal minted. Cold continuation re-verifies against this, which is what replaced the durable Issue body as the tamper anchor."},
        "diverged_from_seal": {"type": "boolean",
                               "description": "True once the executed payload has been revised away from the sealed one on recorded operator authority. Recorded rather than inferred, so the seal cannot silently appear to cover what is actually being built."},
        "digest": {"$ref": "#/$defs/digest"},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "spec_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "authorizing_issue": {"type": ["integer", "null"], "minimum": 1,
                              "description": "The Issue that authorizes this work. Authorization only: the plan authority is the sealed plan, and neither artifact stands in for the other."},
        "profile": {"enum": ["trivial", "normal", "routine"]},
        "bound_head": {"$ref": "#/$defs/commit"}
      }
    },
    "approval": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["plan_digest", "spec_digest", "depth"], "properties": {"plan_digest": {"$ref": "#/$defs/digest"}, "spec_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "depth": {"enum": ["quick", "standard", "thorough"]}}}
      ]
    },
    "reviews": {
      "type": "object", "additionalProperties": false,
      "required": ["deliverable"],
      "properties": {"deliverable": {"$ref": "#/$defs/review_stage"}},
      "description": "One review, and it is the deliverable review. The plan panel moved to the plan side, where it runs once before the seal a Build cannot start without."
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "assumption_dispositions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim", "resolved_as", "basis"], "properties": {"claim": {"type": "string", "minLength": 1}, "resolved_as": {"enum": ["verified", "accepted-risk"]}, "basis": {"type": "string", "minLength": 1}}}},
    "artifact_sync": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["commit", "results"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "status", "changed"], "properties": {"path": {"type": "string"}, "status": {"type": "string"}, "changed": {"type": "boolean"}}}}}}]},
    "checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checkpoint"}]},
    "terminal_condition": {"type": "null",
      "description": "Deprecated inert compatibility field for snapshots written by the withdrawn Stop evaluator. New snapshots omit it; non-null model-authored stop claims are rejected."},
    "progress": {
      "type": "object", "additionalProperties": false, "required": ["current_item", "completed"],
      "properties": {
        "current_item": {"type": ["string", "null"]},
        "completed": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "commit"], "properties": {"id": {"type": "string"}, "commit": {"$ref": "#/$defs/commit"}}}}
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/node_work"}
    },
    "validation": {
      "description": "Three shapes: null; the legacy single slot (result_set), kept so old snapshots and restored handoffs stay readable and normalize on read to candidate-with-null-identity; and the candidate/final split.",
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/result_set"}, {"$ref": "#/$defs/validation_split"}]
    },
    "repair": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["reviewed_commit", "final_commit", "summary", "judgment", "rationale", "lenses", "packet_digest", "receipts"], "properties": {
          "reviewed_commit": {"$ref": "#/$defs/commit"}, "final_commit": {"$ref": "#/$defs/commit"},
          "summary": {"type": "string", "minLength": 1}, "judgment": {"enum": ["none", "scoped", "full"]},
          "rationale": {"type": "string", "minLength": 1}, "lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "base_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
          "packet_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "referent_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "reviewer_contracts": {"type": "array", "items": {"$ref": "#/$defs/reviewer_contract"}},
          "session_effort": {"description": "The reasoning effort the SPAWNING SESSION reported running at when this panel was cut. Self-reported, and on the Claude arm it is the ceiling every un-pinned reviewer in the fan-out inherits (StarshipSuperjam/engine-template#1067).", "oneOf": [{"enum": ["low", "medium", "high"]}, {"type": "null"}]},
          "effort_shortfall_accepted": {"description": "The session spawned this panel knowing it ran below the approved depth's effort. Kept so the hard PR-body disclosure cannot be forgotten.", "type": "boolean"},
          "receipts": {"type": "array", "items": {"$ref": "#/$defs/review_receipt"}},
          "anchor": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
          "counted": {"type": "boolean"},
          "classification": {"oneOf": [{"$ref": "#/$defs/divergence_classification"}, {"type": "null"}]},
          "roster_provenance": {"enum": ["explicit", "blocker-union", "none"]}
        }}
      ]
    },
    "preflights": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "pr_contract": {
      "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["commit", "body_digest", "complete"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "body_digest": {"$ref": "#/$defs/digest"}, "complete": {"type": "boolean"}}}]
    },
    "submission": {"enum": ["draft", "ready", "unknown"]},
    "checkout_snapshot": {
      "type": ["object", "null"],
      "description": "The review_integrity snapshot of the build worktree captured when the most recent deliverable/repair review packet was created (StarshipSuperjam/engine-template#947); the submission preflight verifies origin, branch, and stash have not moved since. Null until a deliverable-side review packet is created; not carried across a cold handoff (re-captured at the next review packet).",
      "additionalProperties": false,
      "properties": {
        "checkout": {"type": "string"},
        "origin": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "head": {"type": ["string", "null"]},
        "stash_count": {"type": ["integer", "null"]},
        "worktrees": {"type": ["array", "null"]}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "divergence_classification": {"type": "object", "additionalProperties": false, "required": ["files", "churn", "total_churn"], "properties": {"anchor": {"type": "string"}, "head": {"type": "string"}, "total_churn": {"type": "integer", "minimum": 0}, "guards_read": {"type": "boolean"}, "files": {"type": "object", "additionalProperties": false, "properties": {"guarded": {"type": "array", "items": {"type": "string"}}, "derived": {"type": "array", "items": {"type": "string"}}, "docs": {"type": "array", "items": {"type": "string"}}, "authored": {"type": "array", "items": {"type": "string"}}}}, "churn": {"type": "object", "additionalProperties": false, "properties": {"guarded": {"type": "integer", "minimum": 0}, "derived": {"type": "integer", "minimum": 0}, "docs": {"type": "integer", "minimum": 0}, "authored": {"type": "integer", "minimum": 0}}}}},
    "node_work": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_count", "claim", "latest_result", "integration", "latest_failure"],
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 0},
        "claim": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/claim"}]},
        "latest_result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/node_result"}]},
        "integration": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/integration"}]},
        "latest_failure": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/node_failure"}]}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "base_sha", "worktree", "acquired_resources", "requested_route", "worker_ref", "restored"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "base_sha": {"$ref": "#/$defs/commit"},
        "worktree": {"type": "string", "minLength": 1},
        "acquired_resources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requested_route": {"$ref": "#/$defs/route"},
        "worker_ref": {"type": ["string", "null"], "minLength": 1},
        "restored": {"type": "boolean"}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_class", "provider", "model", "effort", "inline"],
      "properties": {
        "executor_class": {"enum": ["integrator", "builder", "bounded"]},
        "provider": {"enum": ["claude", "codex"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "inline": {"type": "boolean"}
      }
    },
    "node_result": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "base_sha", "outcome", "artifact_ref", "artifact_digest", "evidence"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "base_sha": {"$ref": "#/$defs/commit"},
        "outcome": {"enum": ["returned", "failed"]},
        "artifact_ref": {"type": ["string", "null"], "minLength": 1},
        "artifact_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["changed_paths", "verification_results", "assumptions", "unresolved_concerns"],
          "properties": {
            "changed_paths": {"type": "array", "items": {"type": "string"}},
            "verification_results": {"type": "array", "items": {"type": "string"}},
            "assumptions": {"type": "array", "items": {"type": "string"}},
            "unresolved_concerns": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "integration": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "commit", "focused_verification"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "commit": {"$ref": "#/$defs/commit"},
        "focused_verification": {"type": "string", "minLength": 1}
      }
    },
    "node_failure": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "class", "reason", "disposition"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "class": {"enum": ["dispatch", "worker", "contract", "verification", "integration"]},
        "reason": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["open", "retry", "abandoned", "integrator-inline"]}
      }
    },
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "review_stage": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_digest", "referent_digest", "required_lenses", "installed_lenses", "reviewer_contracts", "receipts", "reviewed_commit", "base_commit"],
      "properties": {
        "packet_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "referent_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "required_lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "installed_lenses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reviewer_contracts": {"type": "array", "items": {"$ref": "#/$defs/reviewer_contract"}},
        "receipts": {"type": "array", "items": {"$ref": "#/$defs/review_receipt"}},
        "reviewed_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "base_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "session_effort": {"description": "The reasoning effort the SPAWNING SESSION reported running at when this panel was cut. Self-reported, and on the Claude arm it is the ceiling every un-pinned reviewer in the fan-out inherits (StarshipSuperjam/engine-template#1067).", "oneOf": [{"enum": ["low", "medium", "high"]}, {"type": "null"}]},
        "effort_shortfall_accepted": {"description": "The session spawned this panel knowing it ran below the approved depth's effort. Kept so the hard PR-body disclosure cannot be forgotten.", "type": "boolean"}
      },
      "description": "No `waiver` field: the only waivable review was the retrospective plan review, and its precondition — a Build that started before its plan was reviewed — is unreachable now that only a sealed plan can bind. Deliverable review was never waivable."
    },
    "review_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["lens", "packet_digest", "commit", "finding_ids"],
      "properties": {
        "lens": {"type": "string", "minLength": 1}, "packet_digest": {"$ref": "#/$defs/digest"},
        "referent_digest": {"$ref": "#/$defs/digest"}, "lens_packet_digest": {"$ref": "#/$defs/digest"},
        "commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "code_execution": {"description": "What this reviewer did with the change's code. Three real behaviours, three values: it ran nothing, it ran the code in a throwaway copy, or it ran the code in place in the operator's own checkout. Rounding the third to one of the other two made a materially different claim about what touched their project (B2 finding CO-1).", "enum": ["none", "discarded-copy", "in-place"]},
        "reviewed_range": {"description": "The commit range this lens actually READ. What makes a receipt carryable across a re-bind: if the range already contains every authored commit a new binding asks about, the lens owes no further read and the receipt stands unchanged (StarshipSuperjam/engine-template#1065). Absent on a receipt written before ranges existed, which covers nothing rather than everything.", "type": "object", "additionalProperties": false, "required": ["base", "tip"], "properties": {"base": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}, "tip": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}}},
        "delivered_effort": {"description": "The reasoning effort this reviewer reports having run at, compared against the approved depth's promise. Self-reported by the session and the reviewer; nothing here verifies it, and every disclosure of it says so.", "oneOf": [{"enum": ["low", "medium", "high"]}, {"type": "null"}]},
        "spawn_session_effort": {"description": "The effort the session that spawned THIS receipt's panel reported, stamped at record time. A repair receipt is spliced into the deliverable stage, so the stage a receipt sits in no longer says which panel it came from — and inferring it from the repair stage's own receipt list goes stale, which can publish a reviewer as claiming more than its session in a disclosure the operator is meant to trust. Absent on receipts written before this field existed; the disclosure falls back to the stage's session and says nothing it cannot support.", "oneOf": [{"enum": ["low", "medium", "high"]}, {"type": "null"}]}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "lens", "packet_digest", "commit", "severity", "summary", "disposition", "rationale", "escalation_kind", "blocks_this_pr", "handoff_summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "stage": {"enum": ["plan", "deliverable", "repair"]}, "lens": {"type": "string", "minLength": 1},
        "packet_digest": {"$ref": "#/$defs/digest"}, "lens_packet_digest": {"$ref": "#/$defs/digest"}, "commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "severity": {"enum": ["blocking", "serious", "nit"]}, "summary": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["accepted-fixed", "accepted-tracked", "partially-accepted", "rejected", "escalated"]},
        "rationale": {"type": "string", "minLength": 1},
        "escalation_kind": {"type": ["string", "null"], "enum": [null, "design", "law", "authority", "capability-boundary", "guardrail-ack", "operator-only"]},
        "blocks_this_pr": {"type": "boolean"}, "superseded": {"type": "boolean"},
        "handoff_summary": {"type": ["string", "null"], "minLength": 1},
        "operator_summary": {"type": ["string", "null"], "minLength": 1},
        "private_reference": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "reviewer_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["lens", "path", "digest", "lens_packet_digest"],
      "properties": {
        "lens": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}, "lens_packet_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_digest", "objective", "current_work", "work_item", "assumptions", "non_goals", "planned_scope", "changed_paths", "remaining_verification", "judgment", "progress"],
      "properties": {
        "plan_digest": {"$ref": "#/$defs/digest"}, "objective": {"type": "string", "minLength": 1}, "current_work": {"type": "string", "minLength": 1},
        "work_item": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}}, "non_goals": {"type": "array", "items": {"type": "string"}},
        "planned_scope": {"type": "array", "items": {"type": "string"}}, "changed_paths": {"type": "array", "items": {"type": "string"}},
        "remaining_verification": {"type": "array", "items": {"type": "string"}},
        "judgment": {"enum": ["aligned", "plan_revision_required", "operator_decision_required"]},
        "progress": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "commit", "passed", "summary"],
      "properties": {"id": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/commit"}, "passed": {"type": "boolean"}, "summary": {"type": "string", "minLength": 1}, "log_path": {"type": "string", "minLength": 1}, "log_digest": {"$ref": "#/$defs/digest"}}
    },
    "result_set": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "results"],
      "properties": {"commit": {"$ref": "#/$defs/commit"}, "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}}
    },
    "validation_split": {
      "description": "The split evidence model. `candidate` is build-loop evidence — the structural suite plus the affected-selection self-test run, cached by content-addressed identity. `final` is the imported engine-ci proof for the exact head; its ONLY writer is `validate final import`. A legacy single-slot value (the result_set arm above) normalizes on read to a candidate with null identity — never a cache hit, never final.",
      "type": "object", "additionalProperties": false,
      "required": ["candidate", "final"],
      "properties": {
        "candidate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidate_validation"}]},
        "final": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/final_validation"}]}
      }
    },
    "candidate_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "merge_base", "protocol_digest", "argv_digests", "inventory_digest", "run_record", "results"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "merge_base": {"$ref": "#/$defs/commit"},
        "protocol_digest": {"$ref": "#/$defs/digest"},
        "argv_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
        "inventory_digest": {"type": "string", "minLength": 1},
        "run_record": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["id", "digest", "scope", "tree"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "scope": {"enum": ["full", "focused"]}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}]},
        "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}
      }
    },
    "final_validation": {
      "description": "An imported, verified engine-ci proof. `run_id` names the workflow run the platform reported as produced by the registered workflow file; `tree` is the receipt's tree binding, equal to the head's tree under the up-to-date-with-base precondition the import enforces.",
      "type": "object", "additionalProperties": false,
      "required": ["commit", "source", "run_id", "tree", "context"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "source": {"const": "ci-import"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": ["integer", "null"], "minimum": 1},
        "context": {"type": "string", "minLength": 1},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "imported_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
