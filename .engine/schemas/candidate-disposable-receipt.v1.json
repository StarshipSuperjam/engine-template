{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engine.local/schemas/candidate-disposable-receipt.v1.json",
  "title": "Accepted attended candidate disposable-run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "accepted", "candidate", "target", "operation", "invocation", "outcome",
    "canonical", "context_digest", "future_authorization", "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "candidate-disposable-receipt.v1"},
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "commit", "tree", "engine_release", "epoch", "source", "source_ref",
        "materialized_tree", "materialized_inventory"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/objectId"},
        "tree": {"$ref": "#/$defs/objectId"},
        "engine_release": {"type": "string", "minLength": 1},
        "epoch": {"type": "integer", "minimum": 1},
        "source": {"enum": ["reviewed-merge", "published-release"]},
        "source_ref": {"type": "string", "minLength": 1},
        "materialized_tree": {"$ref": "#/$defs/absolutePath"},
        "materialized_inventory": {"$ref": "#/$defs/digest"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "project_root", "commit", "tree", "script", "script_digest", "worktree_dirty",
        "worktree_status_digest", "script_digest_after", "worktree_status_digest_after",
        "code_unchanged_during_run"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "project_root": {"$ref": "#/$defs/absolutePath"},
        "commit": {"$ref": "#/$defs/objectId"},
        "tree": {"$ref": "#/$defs/objectId"},
        "script": {"type": "string", "pattern": "^\\.engine/tools/memory/"},
        "script_digest": {"$ref": "#/$defs/digest"},
        "worktree_dirty": {"type": "boolean"},
        "worktree_status_digest": {"$ref": "#/$defs/digest"},
        "script_digest_after": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "worktree_status_digest_after": {"$ref": "#/$defs/digest"},
        "code_unchanged_during_run": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root", "memory_dir", "store_id", "inventory"],
      "properties": {
        "kind": {"const": "disposable"},
        "root": {"$ref": "#/$defs/absolutePath"},
        "memory_dir": {"$ref": "#/$defs/absolutePath"},
        "store_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "inventory": {"$ref": "#/$defs/inventoryWithEntries"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id", "capability_identity", "writer", "target_kind", "effect_class",
        "declared_cardinality", "schema_cutover", "invocation_mode", "authorized_registry_ids"
      ],
      "properties": {
        "registry_id": {"type": "string", "minLength": 1},
        "capability_identity": {"type": "string", "minLength": 1},
        "writer": {"type": "string", "minLength": 1},
        "target_kind": {"type": "string", "minLength": 1},
        "effect_class": {
          "enum": ["semantic-read", "durable-append", "reversible-mutation", "destructive-irreversible"]
        },
        "declared_cardinality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum", "unit"],
          "properties": {
            "maximum": {"type": ["integer", "null"], "minimum": 0},
            "unit": {"type": "string", "minLength": 1}
          }
        },
        "schema_cutover": {"type": "boolean"},
        "invocation_mode": {"const": "attended"},
        "authorized_registry_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "provider", "run_id", "task_id"],
      "properties": {
        "script": {"type": "string", "minLength": 1},
        "provider": {"enum": ["claude", "codex"]},
        "run_id": {"type": ["string", "null"]},
        "task_id": {"type": ["string", "null"]}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code", "timed_out", "stdout_size", "stdout_digest", "stderr_size", "stderr_digest"
      ],
      "properties": {
        "exit_code": {"type": "integer"},
        "timed_out": {"type": "boolean"},
        "stdout_size": {"type": "integer", "minimum": 0},
        "stdout_digest": {"$ref": "#/$defs/digest"},
        "stderr_size": {"type": "integer", "minimum": 0},
        "stderr_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_inventory_before", "memory_inventory_after", "unchanged"],
      "properties": {
        "memory_inventory_before": {"$ref": "#/$defs/inventorySummary"},
        "memory_inventory_after": {"$ref": "#/$defs/inventorySummary"},
        "unchanged": {"type": "boolean"}
      }
    },
    "context_digest": {"$ref": "#/$defs/digest"},
    "future_authorization": {
      "description": "Reserved opaque handoff seam for issue StarshipSuperjam/engine-template#1145; this revision never issues authorization.",
      "type": ["object", "string", "null"]
    },
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/"},
    "objectId": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "inventorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "total_file_bytes", "inventory_digest"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 0},
        "total_file_bytes": {"type": "integer", "minimum": 0},
        "inventory_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "inventoryWithEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "total_file_bytes", "inventory_digest", "entries"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 0},
        "total_file_bytes": {"type": "integer", "minimum": 0},
        "inventory_digest": {"$ref": "#/$defs/digest"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "mode"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "kind": {"enum": ["directory", "file"]},
              "mode": {"type": "integer", "minimum": 0},
              "size": {"type": "integer", "minimum": 0},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    }
  }
}
