  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "acceptable"
          }
        }
      },
      "then": {
        "properties": {
          "cost_clearance": {
            "const": true
          },
          "violations": {
            "maxItems": 0
          },
          "unknown": {
            "maxItems": 0
          },
          "timing": {
            "properties": {
              "status": {
                "const": "acceptable"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "cost_clearance": {
            "const": false
          }
        }
