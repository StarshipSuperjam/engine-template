{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "reason",
    "revisit",
    "issued_at",
    "expires_at",
    "case",
    "resource",
    "ceiling",
    "source_commit"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "revisit": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "occurrence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resource": {
      "enum": [
        "processes",
        "git_commands",
        "schema_decodes",
        "metaschema_validations",
        "whole_tree_fixtures",
        "nested_journeys"
      ]
    },
    "ceiling": {
      "type": "integer",
      "minimum": 0
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
