{
  "id": "github-projects-sync",
  "version": "0.3.0",
  "status": "optional",
  "presentation": {
    "description": "Show what the engine is building \u2014 what's next, what needs your review, and known issues \u2014 at a glance on a GitHub Projects board. One-time setup creates a board on your GitHub account and asks for a permission that covers all your GitHub Projects (optional and revocable), plus an optional one-time click in GitHub to turn on auto-add. A board is never required: the engine works the same from your issues and pull requests, and you can delete the board later without losing anything.",
    "category": "Product Management",
    "setup_trigger": "set up a project board",
    "setup_operation": ".engine/operations/projects-sync-setup.md"
  },
  "provides": {
    "tool": [
      ".engine/tools/projects_sync/*.py"
    ],
    "operation": [
      ".engine/operations/projects-release-advance.md",
      ".engine/operations/projects-sync-setup.md"
    ],
    "skill": [],
    "codex-skill": []
  },
  "wires": [
    {
      "type": "gitignore",
      "key": "github-projects-sync-board-config",
      "lines": [
        ".engine/projects-sync/"
      ]
    },
    {
      "type": "hook",
      "event": "SessionStart",
      "matcher": "startup",
      "hook": {
        "type": "command",
        "command": "sh \"${CLAUDE_PROJECT_DIR}/.engine/tools/hook-runner.sh\" \"${CLAUDE_PROJECT_DIR}/.engine/.venv/bin/python\" \"${CLAUDE_PROJECT_DIR}/.engine/tools/projects_sync/projects_sync.py\" session-start"
      }
    },
    {
      "type": "hook",
      "event": "SessionStart",
      "matcher": "resume",
      "hook": {
        "type": "command",
        "command": "sh \"${CLAUDE_PROJECT_DIR}/.engine/tools/hook-runner.sh\" \"${CLAUDE_PROJECT_DIR}/.engine/.venv/bin/python\" \"${CLAUDE_PROJECT_DIR}/.engine/tools/projects_sync/projects_sync.py\" session-start"
      }
    },
    {
      "type": "codex-hook",
      "event": "SessionStart",
      "matcher": "startup",
      "hook": {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \".engine/tools/codex-hook-runner.sh\" \".engine/tools/projects_sync/projects_sync.py\" session-start"
      }
    },
    {
      "type": "codex-hook",
      "event": "SessionStart",
      "matcher": "resume",
      "hook": {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && sh \".engine/tools/codex-hook-runner.sh\" \".engine/tools/projects_sync/projects_sync.py\" session-start"
      }
    }
  ],
  "depends": {
    "core": ""
  },
  "retired_capabilities": {
    "0.3.0": {
      "description": "The `engine-board-setup` command is gone. Set up or manage this project's progress board through `engine-setup` instead \u2014 its board-setup section does exactly what that command did. There is no alias; the old name simply stops working, so a stale name fails plainly."
    }
  }
}
