{
  "mcpServers": {
    "engine-knowledge-graph": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PROJECT_DIR:-.}/.engine",
        "--frozen",
        "--",
        "python",
        "tools/knowledge_mcp_server.py"
      ]
    },
    "engine-memory": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PROJECT_DIR:-.}/.engine",
        "--frozen",
        "--",
        "python",
        "tools/accepted_hook_dispatch.py",
        "attended",
        "--root",
        "..",
        "--script",
        ".engine/tools/memory/mcp_server.py",
        "--operation",
        "attended-memory-mcp",
        "--"
      ]
    }
  }
}
